<Window x:Class="FrpDesk.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FrpDesk" Width="960" Height="640" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        FontFamily="Microsoft YaHei UI" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResize" KeyDown="Dialog_KeyDown" Closing="Dialog_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Margin="10" SnapsToDevicePixels="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18" Color="#24334A" />
      </Border.Effect>
    </Border>
    <Grid Grid.Row="0" Margin="18,0,7,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="FrpDesk" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        <TextBlock Text=" · 实例配置" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="9,0,0,0" />
      </StackPanel>
      <Button ToolTip="关闭" Style="{StaticResource CaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" HorizontalAlignment="Right">
        <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
      </Button>
    </Grid>
    <Grid Grid.Row="1" Margin="30,22,30,26">
      <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding WindowHeading}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
      <TextBlock Text="粘贴 frpc TOML 配置，保存后可单独启动此实例。" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,20,0,14">
      <TextBlock Text="实例名称" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,7" />
      <TextBox x:Name="NameBox" Style="{StaticResource TextBoxBase}" Height="42" VerticalContentAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="2,0,0,8" LastChildFill="False">
        <TextBlock Text="TOML 配置" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        <WrapPanel DockPanel.Dock="Right">
          <Button x:Name="ValidateButton" Content="检查配置" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,8,0" Click="Validate_Click" />
          <Button Content="清空" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,8,0" Click="Clear_Click" />
          <Button Content="从文件导入" Style="{StaticResource PillButton}" Padding="12,6" Click="Import_Click" />
        </WrapPanel>
      </DockPanel>
      <Border Grid.Row="1" Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="13" Padding="2">
        <TextBox x:Name="ConfigBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code, Consolas" FontSize="13" Padding="13"
                 Background="Transparent" BorderThickness="0" Foreground="#253044"
                 SpellCheck.IsEnabled="False" TextChanged="ConfigBox_TextChanged" />
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ConfigStatsText" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
        <TextBlock x:Name="ErrorText" Foreground="#DF4D5A" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{StaticResource PillButton}" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button x:Name="SaveButton" Content="保存配置" Style="{StaticResource PrimaryButton}" MinWidth="112" Click="Save_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
  </Grid>
</Window>
