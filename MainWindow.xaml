<Window x:Class="FrpDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FrpDesk.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FrpDesk" Width="980" Height="640" MinWidth="900" MinHeight="580"
        Background="{StaticResource WindowBackground}" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Closed="Window_Closed"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="74" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="18,0,7,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Text="FrpDesk" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        <TextBlock Text=" · frp 客户端" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="9,0,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
        <Button ToolTip="最小化" Style="{StaticResource CaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
          <Path Data="{StaticResource MinimizeGeometry}" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
        </Button>
        <Button x:Name="MaximizeButton" ToolTip="最大化" Style="{StaticResource CaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click">
          <Path x:Name="MaximizeIcon" Data="{StaticResource MaximizeGeometry}" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.45" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
        </Button>
        <Button ToolTip="关闭窗口并保留后台运行" Style="{StaticResource CaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
          <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.Column="0" Background="#EDF0F4" Padding="0,28,0,22">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource Accent}" HorizontalAlignment="Center">
          <TextBlock Text="F" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,54,0,0">
          <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Background="{StaticResource AccentSoft}" Foreground="{StaticResource Accent}" Click="Home_Click">
            <StackPanel HorizontalAlignment="Center">
              <Path x:Name="HomeNavIcon" Data="{StaticResource ListGeometry}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="18" Stretch="Uniform" HorizontalAlignment="Center" />
              <TextBlock x:Name="HomeNavLabel" Text="实例" FontSize="11" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="EndpointsNavButton" Style="{StaticResource NavButton}" ToolTip="地址" Margin="0,10,0,0" Click="Endpoints_Click">
            <StackPanel HorizontalAlignment="Center">
              <Path x:Name="EndpointsNavIcon" Data="{StaticResource LinkGeometry}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="18" Stretch="Uniform" HorizontalAlignment="Center" />
              <TextBlock x:Name="EndpointsNavLabel" Text="地址" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" ToolTip="设置" Margin="0,10,0,0" Click="Settings_Click">
            <StackPanel HorizontalAlignment="Center">
              <Path x:Name="SettingsNavIcon" Data="{StaticResource SettingsGeometry}" Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" />
              <TextBlock x:Name="SettingsNavLabel" Text="设置" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="v0.1" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="HomeContent" Grid.Row="1" Grid.Column="1" Margin="28,24,30,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
           <TextBlock Text="frp 客户端" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
           <TextBlock Text="粘贴配置，保存实例，一键运行。" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="StartAllButton" Content="全部运行" Style="{StaticResource PillButton}" Click="StartAll_Click" Margin="0,0,10,0" />
          <Button x:Name="StopAllButton" Content="全部停止" Style="{StaticResource PillButton}" Click="StopAll_Click" Margin="0,0,10,0" />
          <Button Content="＋ 添加实例" Style="{StaticResource PrimaryButton}" Click="AddProfile_Click" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource SurfaceSubtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,20,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="16,12">
            <TextBlock Text="运行实例" Foreground="{StaticResource TextSecondary}" FontSize="11" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock x:Name="RunningCountText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text=" 个" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,3" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="{StaticResource Line}" Margin="0,10" />
          <StackPanel Grid.Column="2" Margin="16,12">
            <TextBlock Text="配置实例" Foreground="{StaticResource TextSecondary}" FontSize="11" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock x:Name="ProfileCountText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text=" 个" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,3" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="3" Width="1" Background="{StaticResource Line}" Margin="0,10" />
          <StackPanel Grid.Column="4" Margin="16,12">
            <TextBlock Text="frpc 引擎" Foreground="{StaticResource TextSecondary}" FontSize="11" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="0.71.0" Foreground="{StaticResource TextPrimary}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text=" · 内置" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,3" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
           <ColumnDefinition Width="316" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

         <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,10,0" VerticalAlignment="Top">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
             <DockPanel Margin="18,17,14,12" LastChildFill="False">
               <TextBlock Text="实例列表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Profiles.Count}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>
            <Grid Grid.Row="1">
                 <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                        BorderThickness="0" Background="Transparent" Padding="10,0,10,14" SelectionChanged="ProfilesList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                           <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                           <Border x:Name="ItemBorder" Background="{StaticResource SurfaceSubtle}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoft}" />
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="#EEF3FA" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:TunnelProfile}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                         <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                         <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                                 <TextBlock Text="{Binding DisplayState}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="ProfileQuickAction_Click" Tag="{Binding}" Margin="0,0,2,0">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                              <Setter Property="Content" Value="▶" />
                              <Setter Property="ToolTip" Value="运行此实例" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                  <Setter Property="Content" Value="■" />
                                  <Setter Property="ToolTip" Value="停止此实例" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBackgroundConfigured}" Value="True">
                                  <Setter Property="IsEnabled" Value="False" />
                                  <Setter Property="ToolTip" Value="此实例由后台服务管理" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="⋯" Style="{StaticResource IconButton}" ToolTip="更多操作" Click="ProfileMenu_Click" Tag="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="EmptyProfilesPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="还没有实例" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="把你的 TOML 配置粘贴进来吧" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                <Button Content="添加第一个实例" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="AddProfile_Click" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

         <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20,18,20,16" VerticalAlignment="Top">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                 <TextBlock x:Name="SelectedNameText" Text="选择一个实例" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                 <TextBlock x:Name="SelectedStateText" Text="从左侧选择配置开始" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
              </StackPanel>
               <WrapPanel Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                <Button x:Name="EditButton" Content="编辑" Style="{StaticResource PillButton}" Click="EditProfile_Click" Margin="0,0,8,0" />
                <Button x:Name="StatusButton" Content="查看状态" Style="{StaticResource PillButton}" Click="StatusButton_Click" Margin="0,0,8,0" />
                <Button x:Name="ReloadButton" Content="重载配置" Style="{StaticResource PillButton}" Click="ReloadButton_Click" Margin="0,0,8,0" />
                <Button x:Name="BackgroundButton" Content="启用后台服务" Style="{StaticResource PillButton}" Click="BackgroundButton_Click" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Content="▶ 运行" Style="{StaticResource PrimaryButton}" Click="RunButton_Click" />
              </WrapPanel>
            </Grid>
            <Border x:Name="DiagnosticPanel" Grid.Row="1" Background="{StaticResource DangerSoft}" BorderBrush="#F3CDD1" BorderThickness="1" CornerRadius="12" Margin="0,16,0,0" Padding="13,11" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="DiagnosticTitleText" Text="诊断" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                  <TextBlock x:Name="DiagnosticDetailText" TextWrapping="Wrap" FontSize="11" Foreground="#8C4D55" Margin="0,4,12,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="复制诊断" Style="{StaticResource PillButton}" FontSize="11" Padding="10,5" VerticalAlignment="Center" Click="CopyDiagnostic_Click" />
              </Grid>
            </Border>
             <Border Grid.Row="2" Background="#182435" CornerRadius="10" Margin="0,16,0,14" Padding="14" Height="236">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                   <TextBlock Text="运行日志" Foreground="#A6B5C9" FontSize="11" VerticalAlignment="Center" />
                  <Button x:Name="CopyLogButton" Content="复制日志" Style="{StaticResource LogActionButton}" DockPanel.Dock="Right" Click="CopyLog_Click" />
                </DockPanel>
                <Grid Grid.Row="1">
                  <TextBox x:Name="LogTextBox" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                           Background="Transparent" BorderThickness="0" Foreground="#D6DEEA"
                           SelectionBrush="#4D78B5" SelectionTextBrush="White"
                           FontFamily="Cascadia Code, Consolas" FontSize="12"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                           Padding="0" SpellCheck.IsEnabled="False" />
                  <TextBlock x:Name="LogEmptyText" Text="暂无运行日志" Foreground="#72839A" FontSize="12"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
              </Grid>
            </Border>
            <DockPanel Grid.Row="3">
              <TextBlock Text="配置以 UTF-8 保存在本机应用数据目录" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <Button Content="删除实例" Style="{StaticResource PillButton}" Foreground="{StaticResource Danger}" BorderBrush="#F3CDD1" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="96" Click="DeleteProfile_Click" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Grid x:Name="EndpointsContent" Grid.Row="1" Grid.Column="1" Margin="28,28,30,26" HorizontalAlignment="Stretch" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
          <TextBlock Text="地址" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="查看并复制配置中的本地地址和穿透地址。" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
        </StackPanel>
        <Button x:Name="CopyAllEndpointsButton" Content="复制全部" Style="{StaticResource PillButton}" Padding="14,7" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyAllEndpoints_Click" />
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,14" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="配置" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        <ComboBox x:Name="EndpointProfileBox" Grid.Column="1" Style="{StaticResource FrpComboBox}" Height="38" ItemsSource="{Binding Profiles}" SelectionChanged="EndpointProfile_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock x:Name="EndpointSummaryText" Grid.Column="2" Text="" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0" />
      </Grid>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="EndpointsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="EndpointList" ItemsSource="{Binding Endpoints}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:TunnelEndpoint}">
                <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,16" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DisplayType}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0,9,0">
                      <TextBlock Text="本地地址" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                      <Button Style="{StaticResource EndpointAddressButton}" Tag="{Binding}" Click="CopyLocalEndpoint_Click" ToolTip="点击复制本地地址">
                        <StackPanel>
                          <TextBlock Text="{Binding LocalAddress}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Code, Consolas" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                    <Border Grid.Column="2" Width="1" Background="{StaticResource Line}" Margin="9,2" />
                    <StackPanel Grid.Column="3" Margin="18,0,0,0">
                      <TextBlock Text="穿透地址" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                      <Button Style="{StaticResource EndpointAddressButton}" Tag="{Binding}" IsEnabled="{Binding HasCopyableRemoteAddress}" Click="CopyRemoteEndpoint_Click" ToolTip="点击复制穿透地址">
                        <StackPanel>
                          <TextBlock Text="{Binding RemoteAddress}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontFamily="Cascadia Code, Consolas" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyEndpointsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="EmptyEndpointsTitle" Text="暂无可展示的地址" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyEndpointsDetail" Text="选择包含 proxies 配置的实例后，这里会列出地址。" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsContent" Grid.Row="1" Grid.Column="1" Margin="28,24,30,26" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
          <TextBlock Text="设置" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="控制窗口行为和本地日志显示方式。" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
        </StackPanel>
        <Button Content="返回实例" Style="{StaticResource PillButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Home_Click" />
      </Grid>

      <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Center" Margin="0,22,0,0">
        <StackPanel Width="720" HorizontalAlignment="Center">
          <TextBlock Text="窗口行为" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,9" />
          <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,22">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <StackPanel Margin="0,0,62,0">
                  <TextBlock Text="关闭窗口时留在托盘" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Text="关闭按钮只隐藏窗口，前台实例继续运行。" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                </StackPanel>
                <ToggleButton x:Name="CloseToTrayToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Grid>
                <StackPanel Margin="0,0,62,0">
                  <TextBlock Text="记住窗口大小和位置" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Text="下次打开时恢复上一次的窗口布局。" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                </StackPanel>
                <ToggleButton x:Name="RestoreLayoutToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Grid Margin="0,16,0,0">
                <StackPanel Margin="0,0,62,0">
                  <TextBlock Text="开机自动启动" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Text="登录 Windows 后自动启动 FrpDesk，启动时直接进入托盘。" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                </StackPanel>
                <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="日志" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,9" />
          <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,22">
            <Grid>
              <StackPanel Margin="0,0,180,0">
                <TextBlock Text="内存中保留的日志行数" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="只影响界面显示，不会删除磁盘上的后台日志。" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
              </StackPanel>
              <ComboBox x:Name="LogLimitBox" Style="{StaticResource FrpComboBox}" Width="118" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedValuePath="Tag">
                <ComboBoxItem Content="200 行" Tag="200" />
                <ComboBoxItem Content="400 行" Tag="400" />
                <ComboBoxItem Content="800 行" Tag="800" />
              </ComboBox>
            </Grid>
          </Border>

          <TextBlock Text="数据目录" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,9" />
          <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,22">
            <Grid>
              <Border Background="{StaticResource SurfaceSubtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,0">
                <TextBox x:Name="DataPathBox" Height="36" IsReadOnly="True" VerticalContentAlignment="Center" Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,98,0" />
              </Border>
              <Button Content="打开目录" Style="{StaticResource PillButton}" Padding="12,6" HorizontalAlignment="Right" Click="OpenDataFolder_Click" />
            </Grid>
          </Border>

          <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,22">
            <Grid>
              <StackPanel Margin="0,0,180,0">
                <TextBlock Text="窗口布局" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="恢复默认大小并重新居中窗口。" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
              </StackPanel>
              <Button Content="恢复默认窗口大小" Style="{StaticResource PillButton}" Padding="12,7" HorizontalAlignment="Right" Click="ResetWindowLayout_Click" />
            </Grid>
          </Border>

          <DockPanel Margin="0,0,0,24">
            <TextBlock x:Name="SettingsStatusText" Text="" FontSize="11" Foreground="{StaticResource Success}" VerticalAlignment="Center" />
            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" MinWidth="104" HorizontalAlignment="Right" Click="SaveSettings_Click" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="ModalBackdrop" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66142131" Visibility="Collapsed" IsHitTestVisible="True" />
  </Grid>
</Window>
