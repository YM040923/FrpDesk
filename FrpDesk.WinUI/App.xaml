<Application
    x:Class="FrpDesk.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#3159C9</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="#F4F7FB" />
            <SolidColorBrush x:Key="CanvasBackdropBrush" Color="#CCF4F7FB" />
            <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SoftBrush" Color="#F9FBFD" />
            <SolidColorBrush x:Key="AddressChipBrush" Color="#E1E5EA" />
            <SolidColorBrush x:Key="LogSurfaceBrush" Color="#FAFDFF" />
            <SolidColorBrush x:Key="LogWarningRowBrush" Color="#FFFDF9" />
            <SolidColorBrush x:Key="LogErrorRowBrush" Color="#FFFAFA" />
            <SolidColorBrush x:Key="InkBrush" Color="#17283A" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="#365066" />
            <SolidColorBrush x:Key="MutedBrush" Color="#586A7A" />
            <SolidColorBrush x:Key="RuleBrush" Color="#DCE4EC" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#7D90A4" />
            <SolidColorBrush x:Key="SelectionBorderBrush" Color="#B1C4D6" />
            <SolidColorBrush x:Key="ServiceBorderBrush" Color="#CBDaf0" />
            <SolidColorBrush x:Key="SignalBrush" Color="#3159C9" />
            <SolidColorBrush x:Key="SignalDeepBrush" Color="#2347A8" />
            <SolidColorBrush x:Key="SignalSoftBrush" Color="#E5ECFF" />
            <SolidColorBrush x:Key="SignalWashBrush" Color="#F1F5FF" />
            <SolidColorBrush x:Key="SignalInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3159C9" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2A50B7" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2347A8" />
            <SolidColorBrush x:Key="AlertBrush" Color="#A33C3C" />
            <SolidColorBrush x:Key="AlertSoftBrush" Color="#F8EAEA" />
            <SolidColorBrush x:Key="WarningBrush" Color="#805914" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#F6EFDF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1C704D" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E7F2EB" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PaperBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="SignalButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Background" Value="{StaticResource SignalBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SignalInkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="NavigationButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="43" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="NavigationIcon" TargetType="SymbolIcon">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            </Style>
            <Style x:Key="NavigationActiveButton" TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                <Setter Property="Background" Value="{StaticResource PaperBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SignalDeepBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SignalDeepBrush}" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="ProfileSelectorButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Background" Value="{StaticResource PaperBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="9,10" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="AddressChipButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Background" Value="{StaticResource AddressChipBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AddressChipBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="TextInput" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
