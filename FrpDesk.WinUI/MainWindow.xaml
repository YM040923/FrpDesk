<Window
    x:Class="FrpDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrpDesk">
    <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- chrome：顶栏与侧栏是同一片表面，之间不画线 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Height="48"
              Background="Transparent" AutomationProperties.Name="FrpDesk 窗口标题栏">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="16" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TitleBarDragArea" Grid.ColumnSpan="4" Background="Transparent" />
            <Button x:Name="RailToggleButton" Grid.Column="1" Width="40" Height="32" Margin="8,0,0,0"
                    Style="{StaticResource QuietButton}" Padding="0" MinHeight="32" CornerRadius="8"
                    Background="Transparent" BorderThickness="0" Click="RailToggle_Click"
                    ToolTipService.ToolTip="展开或收起侧边栏"
                    AutomationProperties.Name="切换侧边栏">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
            </Button>
        </Grid>
        <Border x:Name="NavigationRail" Grid.Row="1" Grid.Column="0" Background="Transparent">
            <Grid x:Name="RailRoot" Margin="12,18,12,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="RailBrandRow" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Left">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource SignalBrush}">
                        <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 8.5,8 C 6.2,10 6.2,14 8.5,16"
                                  Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 15.5,8 C 17.8,10 17.8,14 15.5,16"
                                  Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 5.5,4.5 C 1.2,8 1.2,16 5.5,19.5"
                                  Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 18.5,4.5 C 22.8,8 22.8,16 18.5,19.5"
                                  Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Width="3" Height="3" Fill="{StaticResource SignalInkBrush}"
                                     Canvas.Left="10.5" Canvas.Top="10.5" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="RailBrandText" Text="FrpDesk" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="ProfileMenuButton" Grid.Row="1" Style="{StaticResource ProfileSelectorButton}"
                        Margin="0,20,0,0" Click="ProfileMenu_Click"
                        ToolTipService.ToolTip="切换配置"
                        AutomationProperties.Name="切换配置">
                    <Grid x:Name="RailProfileGrid" ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="RailProfileTextColumn" Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Document" Style="{StaticResource NavigationIcon}"
                                    Foreground="{StaticResource SignalBrush}" VerticalAlignment="Center" />
                        <StackPanel x:Name="RailProfileText" Grid.Column="1" Spacing="2" MinWidth="0">
                            <TextBlock Text="当前配置" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue=未选择配置, TargetNullValue=未选择配置}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="当前配置"
                                       AutomationProperties.HelpText="{Binding SelectedProfile.Name}" />
                        </StackPanel>
                        <FontIcon x:Name="RailProfileChevron" Grid.Column="2" Glyph="&#xE70D;"
                                  FontFamily="Segoe MDL2 Assets" FontSize="11"
                                  Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <StackPanel x:Name="NavigationButtons" Grid.Row="2" Spacing="6" HorizontalAlignment="Stretch">
                    <Button x:Name="HomeNavButton" Style="{StaticResource NavigationActiveButton}" Click="Home_Click"
                            ToolTipService.ToolTip="运行概览">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon x:Name="HomeNavIcon" Symbol="AllApps" Style="{StaticResource NavigationIcon}" />
                            <TextBlock x:Name="HomeNavLabel" Text="运行概览" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProfilesNavButton" Style="{StaticResource NavigationButton}" Click="Profiles_Click"
                            ToolTipService.ToolTip="配置管理">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon x:Name="ProfilesNavIcon" Symbol="List" Style="{StaticResource NavigationIcon}" />
                            <TextBlock x:Name="ProfilesNavLabel" Text="配置管理" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EndpointsNavButton" Style="{StaticResource NavigationButton}" Click="Endpoints_Click"
                            ToolTipService.ToolTip="隧道管理">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon x:Name="EndpointsNavIcon" Symbol="Link" Style="{StaticResource NavigationIcon}" />
                            <TextBlock x:Name="EndpointsNavLabel" Text="隧道管理" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogsNavButton" Style="{StaticResource NavigationButton}" Click="Logs_Click"
                            ToolTipService.ToolTip="运行日志">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon x:Name="LogsNavIcon" Symbol="Bullets" Style="{StaticResource NavigationIcon}" />
                            <TextBlock x:Name="LogsNavLabel" Text="运行日志" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavigationButton}" Click="Settings_Click"
                            ToolTipService.ToolTip="设置">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon x:Name="SettingsNavIcon" Symbol="Setting" Style="{StaticResource NavigationIcon}" />
                            <TextBlock x:Name="SettingsNavLabel" Text="设置" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 主体：一张带自己边缘的卡，四周只留 5 的沟槽 -->
        <Border x:Name="ContentCard" Grid.Row="1" Grid.Column="1" Padding="0"
                Margin="{StaticResource ChromeGutter}" CornerRadius="{StaticResource ContentCardCornerRadius}"
                Background="{StaticResource ContentCardBrush}" BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <InfoBar x:Name="NoticeBar" Grid.Row="0" Margin="20,12,20,0" IsOpen="False" IsClosable="True"
                         CloseButtonClick="NoticeBar_CloseButtonClick" />
                <Grid x:Name="PageHost" Grid.Row="1">
                <!-- ===== 运行概览 ===== -->
                <ScrollViewer x:Name="HomeContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="HomeLayout" Margin="26,22,26,22" Spacing="18">
                        <Grid>
                            <TextBlock Style="{StaticResource PageTitle}" Text="运行概览" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BackgroundServiceButton" Content="启用后台服务"
                                        Style="{StaticResource QuietButton}" MinWidth="124"
                                        AutomationProperties.Name="当前配置的后台服务"
                                        Click="BackgroundServiceButton_Click" />
                                <Button x:Name="RunButton" Content="运行服务" Style="{StaticResource SignalButton}"
                                        MinWidth="124" Click="RunButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ServiceSummaryCard" Style="{StaticResource Card}"
                                CornerRadius="18" Padding="28,22">
                            <Grid x:Name="ServiceSummaryGrid" ColumnSpacing="28">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel x:Name="ServiceStateContent" Orientation="Horizontal" Spacing="16"
                                            VerticalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="13"
                                            Background="{StaticResource SoftBrush}" BorderBrush="{StaticResource RuleBrush}"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="ServiceStateGlyph" Data="M 2,13 L 8,13 L 11,4 L 15,21 L 18,10 L 23,10"
                                                  Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                                        <Ellipse x:Name="ServiceStateDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="SelectedStateText" Text="未选择配置" FontSize="24"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ServiceMetaContent" Grid.Column="1" Spacing="3"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ServerEndpointText" Text="未配置"
                                               Style="{StaticResource Mono}" Foreground="{StaticResource InkSoftBrush}"
                                               TextWrapping="NoWrap" HorizontalAlignment="Right"
                                               ToolTipService.ToolTip="服务器地址" />
                                    <TextBlock x:Name="TunnelCountText" Text="暂无隧道"
                                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="DiagnosticPanel" Background="{StaticResource AlertSoftBrush}"
                                BorderBrush="{StaticResource AlertBrush}" BorderThickness="1" CornerRadius="12"
                                Padding="16,12" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="DiagnosticTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiagnosticDetailText" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制诊断" Style="{StaticResource QuietButton}"
                                        VerticalAlignment="Center" Click="CopyDiagnostic_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="OverviewTunnelHeader" Padding="20,15,20,7">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.0*" />
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="116" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource HeadCell}" Text="名称" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="本地服务" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="公网地址" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="状态" />
                                    </Grid>
                                </Border>
                                <ListView x:Name="OverviewEndpointList" Grid.Row="1" ItemsSource="{Binding Endpoints}"
                                          Style="{StaticResource CompactList}" ItemContainerStyle="{StaticResource TableRow}"
                                          SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                          SelectionChanged="OverviewEndpointList_SelectionChanged"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="20,13">
                                                <Grid ColumnSpacing="18" MinHeight="36">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.8*" />
                                                        <ColumnDefinition Width="1.0*" />
                                                        <ColumnDefinition Width="1.7*" />
                                                        <ColumnDefinition Width="116" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LocalAddress}"
                                                               Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource InkBrush}"
                                                               ToolTipService.ToolTip="{Binding LocalAddress}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RemoteAddress}"
                                                               Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource InkBrush}"
                                                               ToolTipService.ToolTip="{Binding RemoteCopyText}" />
                                                    <Grid Grid.Column="3" ColumnSpacing="9" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                 Fill="{Binding Status, Converter={StaticResource ProxyStatusBrush}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="14"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Status, Converter={StaticResource ProxyStatusBrush}}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="HomeEmptyTunnelsPanel" Grid.Row="1" MinHeight="150"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="5" Margin="20,40" Visibility="Collapsed">
                                    <TextBlock x:Name="HomeEmptyTunnelsTitle" Style="{StaticResource RowTitle}" FontSize="16"
                                               Text="当前配置还没有隧道" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="HomeEmptyTunnelsDetail" Text="添加首条隧道后，运行状态会在这里汇总。"
                                               FontSize="14" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,5,0,16" />
                                    <Button x:Name="HomeEmptyAddTunnelButton" Content="添加隧道"
                                            Style="{StaticResource SignalButton}" MinHeight="38" Padding="12,6"
                                            HorizontalAlignment="Center" Click="AddTunnel_Click" />
                                    <Button x:Name="HomeEmptyAddProfileButton" Content="添加配置"
                                            Style="{StaticResource SignalButton}" MinHeight="38" Padding="12,6"
                                            HorizontalAlignment="Center" Click="AddProfile_Click" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                    <TextBlock Style="{StaticResource BandTitle}" Text="最近活动" />
                                    <Button x:Name="OpenFullLogButton" Style="{StaticResource BandButton}" Content="查看完整日志"
                                            HorizontalAlignment="Right" Click="Logs_Click" />
                                </Grid>
                                <ItemsControl x:Name="RecentActivityList" Grid.Row="1" ItemsSource="{Binding RecentActivityRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="9"
                                                            Background="{StaticResource SoftBrush}"
                                                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="{Binding Mark}" FontFamily="Segoe MDL2 Assets"
                                                                  FontSize="13" Foreground="{Binding MarkBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                                        <TextBlock Text="{Binding Message}" FontSize="15" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                                                   FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="RecentActivityEmptyText" Grid.Row="1" Text="当前暂无 frpc 输出。"
                                           FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="20,13,20,17" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 配置管理 ===== -->
                <Grid x:Name="ProfilesContent" Margin="26,22,26,22" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="ProfilesHeaderGrid" Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PageTitle}" Text="配置管理" VerticalAlignment="Center" />
                        <StackPanel x:Name="ProfilesHeaderActions" Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                            <Button x:Name="ProfilesStopAllButton" Content="全部停止" Style="{StaticResource QuietButton}"
                                    Click="StopAll_Click" />
                            <Button x:Name="ProfilesStartAllButton" Content="全部运行" Style="{StaticResource QuietButton}"
                                    Click="StartAll_Click" />
                            <Button Content="＋ 添加配置" Style="{StaticResource SignalButton}" Click="AddProfile_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ProfilesBandMeta" Grid.Row="1" Style="{StaticResource BandMeta}"
                                   Text="0 个配置" Margin="1,7,0,0" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border x:Name="ProfilesHeaderRow" Padding="20,15,20,7">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="216" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource HeadCell}" Text="配置" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="服务器" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="隧道" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="状态" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="操作"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <ListView x:Name="ProfileList" ItemsSource="{Binding ProfileRows}"
                                          Style="{StaticResource CompactList}" ItemContainerStyle="{StaticResource TableRow}"
                                          Background="Transparent" BorderThickness="0" SelectionMode="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="20,11">
                                                <Grid ColumnSpacing="18" MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.6*" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="0.9*" />
                                                        <ColumnDefinition Width="216" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ServerText}"
                                                               Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{Binding ServerText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding TunnelCountText}" FontSize="14"
                                                               Foreground="{StaticResource InkSoftBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Grid Grid.Column="3" ColumnSpacing="9" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                 Fill="{Binding StateBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="14"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding StateBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{Binding StateText}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="{Binding ActionText}" Style="{StaticResource QuietButton}"
                                                                Padding="10,5" MinHeight="32" FontSize="14" MinWidth="56"
                                                                IsEnabled="{Binding CanToggle}"
                                                                Tag="{Binding}" Click="ProfileRowToggle_Click" />
                                                        <Button Content="编辑" Style="{StaticResource QuietButton}"
                                                                Padding="10,5" MinHeight="32" FontSize="14" MinWidth="56"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Tag="{Binding}" Click="ProfileRowEdit_Click" />
                                                        <Button Content="删除" Style="{StaticResource QuietButton}"
                                                                Padding="10,5" MinHeight="32" FontSize="14" MinWidth="56"
                                                                Foreground="{StaticResource AlertBrush}"
                                                                IsEnabled="{Binding CanDelete}"
                                                                Tag="{Binding}" Click="ProfileRowDelete_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="ProfilesEmptyPanel" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Spacing="5" Visibility="Collapsed"
                                            MaxWidth="420" Margin="20,46">
                                    <TextBlock Style="{StaticResource RowTitle}" FontSize="16" Text="还没有配置"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="添加一个 FRP 配置后，可以在这里启动、停止、编辑或删除。"
                                               FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,5,0,16" />
                                    <Button Content="添加配置" Style="{StaticResource SignalButton}"
                                            MinHeight="38" Padding="12,6" HorizontalAlignment="Center"
                                            Click="AddProfile_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 隧道管理 ===== -->
                <Grid x:Name="EndpointsContent" Margin="26,22,26,22" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="EndpointHeaderGrid" Margin="0,0,0,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PageTitle}" Text="隧道管理" VerticalAlignment="Center" />
                        <StackPanel x:Name="EndpointHeaderActions" Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                            <Button x:Name="EditSelectedTunnelButton" Content="编辑所选隧道" Style="{StaticResource QuietButton}"
                                    IsEnabled="False" Click="EditSelectedTunnel_Click"
                                    ToolTipService.ToolTip="选择一个隧道后即可编辑。" />
                            <Button x:Name="AddTunnelButton" Content="＋ 添加隧道" Style="{StaticResource SignalButton}"
                                    Click="AddTunnel_Click" />
                        </StackPanel>
                        <TextBlock x:Name="EndpointBandMeta" Grid.Row="1" Style="{StaticResource BandMeta}"
                                   Text="0 条" Margin="1,7,0,0" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Border x:Name="EndpointTableBorder" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border x:Name="EndpointHeaderRow" Padding="20,15,20,7">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.0*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="116" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource HeadCell}" Text="名称" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="本地服务" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="公网地址" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="状态" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <ListView x:Name="EndpointList" ItemsSource="{Binding Endpoints}"
                                              Style="{StaticResource CompactList}" ItemContainerStyle="{StaticResource TableRow}"
                                              Background="Transparent" BorderThickness="0" SelectionMode="Single"
                                              SelectionChanged="EndpointList_SelectionChanged"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="20,13">
                                                    <Grid ColumnSpacing="18" MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="1.0*" />
                                                            <ColumnDefinition Width="1.8*" />
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="116" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LocalAddress}"
                                                                   Style="{StaticResource Mono}"
                                                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding LocalAddress}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RemoteAddress}"
                                                                   Style="{StaticResource Mono}"
                                                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding RemoteCopyText}" />
                                                        <Button Grid.Column="3" Style="{StaticResource CopyButton}" Tag="{Binding}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Click="CopyRemoteEndpoint_Click"
                                                                IsEnabled="{Binding HasCopyableRemoteAddress}"
                                                                ToolTipService.ToolTip="{Binding CopyActionLabel}"
                                                                AutomationProperties.Name="{Binding CopyActionLabel}"
                                                                AutomationProperties.HelpText="{Binding RemoteCopyText}">
                                                            <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                                        </Button>
                                                        <Grid Grid.Column="4" ColumnSpacing="9" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={StaticResource ProxyStatusBrush}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="14"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Foreground="{Binding Status, Converter={StaticResource ProxyStatusBrush}}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel x:Name="EmptyEndpointsPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Spacing="5" Visibility="Collapsed" MaxWidth="420" Margin="20,46">
                                        <TextBlock x:Name="EmptyEndpointsTitle" Style="{StaticResource RowTitle}" FontSize="16"
                                                   Text="暂无隧道" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="EmptyEndpointsDetail" Text="可添加首条隧道，或编辑完整 TOML 配置。" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,16" />
                                        <Button x:Name="EmptyAddTunnelButton" Content="添加隧道" Style="{StaticResource SignalButton}"
                                                MinHeight="38" Padding="12,6" HorizontalAlignment="Center"
                                                Click="AddTunnel_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="NoProfilePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="6" Visibility="Collapsed" MaxWidth="420" Margin="16">
                            <TextBlock x:Name="NoProfileTitle" Style="{StaticResource RowTitle}" FontSize="16" Text="尚未选择配置"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="NoProfileDetail" Text="隧道保存在配置文件中；请先添加或选择一个 FRP 配置。" FontSize="14"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,16" />
                            <Button x:Name="EmptyAddProfileButton" Content="添加配置" Style="{StaticResource SignalButton}"
                                    MinHeight="38" Padding="12,6" HorizontalAlignment="Center" Click="AddProfile_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== 编辑隧道 ===== -->
                <Grid x:Name="TunnelEditorContent" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="TunnelEditorHeaderGrid" Margin="26,22,26,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="TunnelEditorTitle" Text="编辑隧道" Style="{StaticResource PageTitle}"
                                   VerticalAlignment="Center" />
                        <StackPanel x:Name="EditorHeaderActions" Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                            <Button Content="取消" Style="{StaticResource QuietButton}" Click="TunnelEditorCancel_Click" />
                            <Button Content="保存更改" Style="{StaticResource SignalButton}" MinWidth="126" Click="SaveTunnel_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                        <StackPanel x:Name="TunnelEditorForm" Margin="26,0,26,22" Spacing="18">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="基本信息" />
                                    </Grid>
                                    <Grid Padding="20,18,20,20" ColumnSpacing="22" RowSpacing="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="隧道名称" />
                                            <TextBox x:Name="TunnelNameBox" Style="{StaticResource TextInput}" MaxLength="128" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="隧道类型" />
                                            <ComboBox x:Name="TunnelTypeBox" SelectedValuePath="Tag" MinHeight="42"
                                                      HorizontalAlignment="Stretch" SelectionChanged="TunnelType_SelectionChanged">
                                                <ComboBoxItem Content="TCP" Tag="tcp" /><ComboBoxItem Content="UDP" Tag="udp" />
                                                <ComboBoxItem Content="HTTP" Tag="http" /><ComboBoxItem Content="HTTPS" Tag="https" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="7">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="备注" />
                                            <TextBox x:Name="TunnelNoteBox" Style="{StaticResource TextInput}" MaxLength="256" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="本地端点" />
                                    </Grid>
                                    <Grid Padding="20,18,20,20" ColumnSpacing="22">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="本地地址" />
                                            <TextBox x:Name="TunnelLocalHostBox" Style="{StaticResource TextInput}" MaxLength="255" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="本地端口" />
                                            <TextBox x:Name="TunnelLocalPortBox" Style="{StaticResource TextInput}" MaxLength="5" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="远端暴露" />
                                    </Grid>
                                    <Grid x:Name="TcpRemotePanel" Padding="20,18,20,4" ColumnSpacing="22">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock x:Name="RemotePortLabel" Style="{StaticResource FieldLabel}" Text="公网端口" />
                                            <TextBox x:Name="TunnelRemotePortBox" Style="{StaticResource TextInput}" MaxLength="5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="服务器" />
                                            <TextBox x:Name="TunnelServerAddressBox" Style="{StaticResource TextInput}"
                                                     IsReadOnly="True" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="HttpRemotePanel" Padding="20,18,20,4" Spacing="18" Visibility="Collapsed">
                                        <StackPanel Spacing="7">
                                            <TextBlock x:Name="TunnelDomainsLabel" Style="{StaticResource FieldLabel}"
                                                       Text="自定义域名（每行一个）" />
                                            <TextBox x:Name="TunnelDomainsBox" Style="{StaticResource TextInput}" AcceptsReturn="True"
                                                     MinHeight="72" MaxLength="2048" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="TunnelUseSubdomainCheck" Content="使用服务端配置的子域名"
                                                  Checked="TunnelUseSubdomain_Changed" Unchecked="TunnelUseSubdomain_Changed" />
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="7">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="公网端口（vhost）" />
                                                <TextBox x:Name="TunnelPublicPortBox" Style="{StaticResource TextInput}" MaxLength="5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="7">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="服务器" />
                                                <TextBox x:Name="TunnelHttpServerBox" Style="{StaticResource TextInput}"
                                                         IsReadOnly="True" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="TunnelEditorHintText" Padding="20,14,20,18" FontSize="14"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== 运行日志 ===== -->
                <Grid x:Name="LogsContent" Margin="26,22,26,22" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Style="{StaticResource PageTitle}" Text="运行日志" VerticalAlignment="Center" />
                        <Button x:Name="CopyLogButton" Content="复制日志" Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyLog_Click" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="{StaticResource SoftBrush}" Padding="20,13">
                                <Grid ColumnSpacing="12">
                                    <TextBlock Style="{StaticResource BandTitle}" Text="frpc 输出" />
                                    <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse x:Name="LogLiveDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="LogLiveStatus" Text="服务未运行" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <ListView x:Name="LogLinesList" ItemsSource="{Binding LogEntries}" SelectionMode="Multiple"
                                          ItemContainerStyle="{StaticResource TableRow}"
                                          Background="Transparent" BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBrush}" Padding="20,7">
                                                <Grid ColumnSpacing="18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="13"
                                                               FontWeight="Bold" Foreground="{Binding LevelBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Mono}"
                                                               FontSize="14" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="LogEmptyText" Text="启动服务后，frpc 输出会显示在这里。" FontSize="15"
                                           Foreground="{StaticResource MutedBrush}" Margin="20,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 设置 ===== -->
                <Grid x:Name="SettingsContent" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="SettingsHeaderGrid" Margin="26,22,26,18">
                        <TextBlock Style="{StaticResource PageTitle}" Text="设置" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsStatusText" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Right" />
                            <Button Content="保存设置" Style="{StaticResource SignalButton}" MinWidth="124"
                                    VerticalAlignment="Center" Click="SaveSettings_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsLayout" Spacing="18" Margin="26,0,26,22">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="窗口与启动" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="关闭窗口时最小化到托盘" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" Style="{StaticResource RowSwitch}"
                                                      AutomationProperties.Name="关闭窗口时最小化到托盘" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="恢复窗口布局" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RestoreLayoutToggle" Grid.Column="1" Style="{StaticResource RowSwitch}"
                                                      AutomationProperties.Name="恢复窗口布局" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="登录 Windows 后自动启动" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource RowSwitch}"
                                                      AutomationProperties.Name="登录 Windows 后自动启动" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="外观" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="窗口背景材质" />
                                        </StackPanel>
                                        <ComboBox x:Name="BackdropMaterialBox" Grid.Column="1" SelectedValuePath="Tag"
                                                  Width="180" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                  AutomationProperties.Name="窗口背景材质"
                                                  SelectionChanged="BackdropMaterial_SelectionChanged">
                                            <ComboBoxItem Content="Mica" Tag="Mica" />
                                            <ComboBoxItem Content="Mica Alt" Tag="Mica Alt" />
                                            <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                                            <ComboBoxItem Content="Acrylic Thin" Tag="Acrylic Thin" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock x:Name="BackdropSupportText" FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="20,0,20,14" Visibility="Collapsed" />
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="点缀色主题" />
                                        </StackPanel>
                                        <StackPanel x:Name="ThemeChoicePanel" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="侧栏" />
                                        </StackPanel>
                                        <ComboBox x:Name="RailModeBox" Grid.Column="1" SelectedValuePath="Tag" Width="150"
                                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                                  AutomationProperties.Name="侧栏宽度"
                                                  SelectionChanged="RailMode_SelectionChanged">
                                            <ComboBoxItem Content="展开" Tag="wide" />
                                            <ComboBoxItem Content="收起（图标）" Tag="icon" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="日志" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="界面保留的日志行数" />
                                        </StackPanel>
                                        <ComboBox x:Name="LogLimitBox" Grid.Column="1" SelectedValuePath="Tag" Width="140"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="界面保留的日志行数">
                                            <ComboBoxItem Content="200 行" Tag="200" /><ComboBoxItem Content="400 行" Tag="400" />
                                            <ComboBoxItem Content="800 行" Tag="800" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="本地数据" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center" MinWidth="0">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="配置与诊断目录" />
                                            <TextBlock x:Name="DataPathBox" Style="{StaticResource Mono}" FontSize="13.5"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" ToolTipService.ToolTip="应用数据目录"
                                                       AutomationProperties.Name="应用数据目录" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Content="打开目录" Style="{StaticResource QuietButton}" Click="OpenDataFolder_Click" />
                                            <Button Content="恢复默认布局" Style="{StaticResource QuietButton}"
                                                    Click="ResetWindowLayout_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid Background="{StaticResource SoftBrush}" Padding="20,13">
                                        <TextBlock Style="{StaticResource BandTitle}" Text="关于" />
                                    </Grid>
                                    <Grid Padding="20,18" ColumnSpacing="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource SignalBrush}">
                                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M 8.5,8 C 6.2,10 6.2,14 8.5,16"
                                                          Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="M 15.5,8 C 17.8,10 17.8,14 15.5,16"
                                                          Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="M 5.5,4.5 C 1.2,8 1.2,16 5.5,19.5"
                                                          Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="M 18.5,4.5 C 22.8,8 22.8,16 18.5,19.5"
                                                          Stroke="{StaticResource SignalInkBrush}" StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Ellipse Width="3" Height="3" Fill="{StaticResource SignalInkBrush}"
                                                             Canvas.Left="10.5" Canvas.Top="10.5" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="AboutVersionText" Style="{StaticResource RowTitle}" Text="FrpDesk" />
                                                <TextBlock x:Name="AboutUpdateText" Style="{StaticResource RowDesc}"
                                                           Text="" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource QuietButton}"
                                                    Click="CheckUpdate_Click" />
                                            <Button Content="发布页" Style="{StaticResource QuietButton}"
                                                    Click="OpenReleases_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
