<ContentDialog
    x:Class="FrpDesk.Views.ProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding WindowHeading}"
    Closing="Dialog_Closing"
    Background="{StaticResource FloatingSurfaceBrush}"
    BorderBrush="{StaticResource RuleBrush}"
    BorderThickness="1"
    KeyboardAcceleratorPlacementMode="Hidden">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">648</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">728</x:Double>
        <CornerRadius x:Key="ContentDialogCornerRadius">14</CornerRadius>
        <Thickness x:Key="ContentDialogPadding">24</Thickness>
    </ContentDialog.Resources>
    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
        </DataTemplate>
    </ContentDialog.TitleTemplate>
    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_KeyboardAcceleratorInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="Close_KeyboardAcceleratorInvoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="680" MinHeight="452">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="粘贴 frpc TOML 配置，保存后可单独启动此实例。"
                   Style="{StaticResource RowDesc}" Margin="0,2,0,20" />

        <StackPanel Grid.Row="1" Spacing="7" Margin="0,0,0,20">
            <TextBlock Style="{StaticResource FieldLabel}" Text="实例名称" />
            <TextBox x:Name="NameBox" Style="{StaticResource TextInput}" MaxLength="128" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="TOML 配置" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ValidateButton" Content="检查配置" Style="{StaticResource QuietButton}"
                            Padding="11,5" MinHeight="32" FontSize="14" Click="Validate_Click" />
                    <Button Content="清空" Style="{StaticResource QuietButton}"
                            Padding="11,5" MinHeight="32" FontSize="14" Click="Clear_Click" />
                    <Button Content="从文件导入" Style="{StaticResource QuietButton}"
                            Padding="11,5" MinHeight="32" FontSize="14" Click="Import_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource SoftBrush}"
                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="2">
                <TextBox x:Name="ConfigBox" AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono"
                         FontSize="13" Padding="12" Background="Transparent"
                         BorderThickness="0" Foreground="{StaticResource InkBrush}"
                         TextChanged="ConfigBox_TextChanged" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="4">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource AlertBrush}"
                       FontSize="13.5" TextWrapping="Wrap" />
            <TextBlock x:Name="ConfigStatsText" Foreground="{StaticResource MutedBrush}"
                       FontSize="13.5" />
        </StackPanel>

        <Border x:Name="ActionPanel" Grid.Row="4" Background="{StaticResource WarningSoftBrush}"
                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="10"
                Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock x:Name="ActionText" TextWrapping="Wrap" FontSize="14"
                           Foreground="{StaticResource InkBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="ActionPrimaryButton" Content="保存并关闭"
                            Style="{StaticResource SignalButton}" Padding="10,5"
                            MinHeight="32" FontSize="14" Click="ActionPrimary_Click" />
                    <Button x:Name="ActionSecondaryButton" Content="放弃"
                            Style="{StaticResource QuietButton}" Padding="10,5"
                            MinHeight="32" FontSize="14" Click="ActionSecondary_Click" />
                    <Button Content="继续编辑" Style="{StaticResource QuietButton}"
                            Padding="10,5" MinHeight="32" FontSize="14" Click="ActionCancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource QuietButton}"
                    MinWidth="96" Click="Cancel_Click" />
            <Button x:Name="SaveProfileButton" Content="保存配置" Style="{StaticResource SignalButton}"
                    MinWidth="120" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</ContentDialog>
